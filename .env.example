# ==========================================
# SHREYAS VAID PORTFOLIO - ENVIRONMENT CONFIG
# ==========================================

# Server-Side AI API Configuration (Optional)
# Supports Google Gemini API (gemini-1.5-flash) or compatible REST endpoints.
# If not provided, the companion operates using the built-in deterministic factual knowledge engine.
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# Standalone Server Port (Default: 3000)
PORT=3000

# Frontend API Base URL (Optional - leave empty for same-origin dev & production)
# VITE_API_BASE_URL=http://localhost:3000

# Allowed CORS Origin for production (Optional - leave empty for same-origin / localhost)
# ALLOWED_ORIGIN=https://shreyas-vaid.vercel.app
